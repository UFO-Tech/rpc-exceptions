{
    "name": "ufo-tech/rpc-exceptions",
    "description": "Exception package RPC server error codes",
    "license": "MIT",
    "authors": [
        {
            "name": "Alex Maystrenko",
            "email": "ashterix69@gmail.com"
        }
    ],
    "type": "library",
    "homepage": "https://github.com/ufo-tech/rpc-exceptions",
    "keywords": ["ufo", "api", "errors", "json-rpc", "rpc"],
    "minimum-stability": "dev",
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*"
    },
    "autoload": {
        "psr-4": {
            "Ufo\\RpcError\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.0.x-dev"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload-dev": {
        "psr-4": {
            "Ufo\\RpcError\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "archive": {
        "exclude": [
            "/tests"
        ]
    }
}
